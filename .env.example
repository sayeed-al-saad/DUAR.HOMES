# Copy this file to .env.local and fill it in. .env.local is ignored by git.
#
# With nothing set, the site runs in DEMO MODE: bundled demo listings, login switched off.

# --- Supabase -----------------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (newer projects) ...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ... or the anon key (older projects). Set one of the two, not both.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Both keys above are designed to be public; row-level security protects the data.
# NEVER put the service-role / secret key in a NEXT_PUBLIC_ variable.
# The site itself never uses the service-role key. Only the crawler does (see below).

# --- Site ---------------------------------------------------------------------
# Public address of the site, without a trailing slash. Used in sign-up
# confirmation links and page metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Data source (optional) ---------------------------------------------------
# demo      always use the bundled demo listings
# supabase  always use the database
# unset     database when Supabase is configured, demo otherwise
# DATA_SOURCE=demo

# --- Crawler (optional; see docs/crawler.md) ------------------------------------
# Your real email address, or an https page about you. It is sent with every
# request the crawler makes, so the site being read can reach you. The crawler
# will not run without it.
# CRAWLER_CONTACT=you@your-domain.com
#
# Seconds between two requests to the same site. Default 8, cannot go below 3.
# CRAWLER_DELAY_SECONDS=8
#
# Lets the crawler write to the database. Supabase dashboard -> Project
# Settings -> API. Without it (or with --local) results go to a local file.
# Server-side only: never give it a NEXT_PUBLIC_ name, never commit it.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Search map ---------------------------------------------------------------
# Map tiles. Left empty, the map uses OpenStreetMap's own tile server, which is
# fine for testing and light use but not for a busy site
# (https://operations.osmfoundation.org/policies/tiles/). For production, use a
# tile provider you have an account with and give its URL and credit line here.
# NEXT_PUBLIC_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png?key=...
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
